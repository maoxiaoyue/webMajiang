<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>

<!-- Polyfills bundle. -->
<script src="src/polyfills.bundle.js" charset="utf-8"> </script>

<!-- SystemJS support. -->
<script src="src/system.bundle.js" charset="utf-8"> </script>

<!-- Import map -->
<script src="src/import-map.json" type="systemjs-importmap" charset="utf-8"> </script>

<script>
    System.import('./index.js').catch(function(err) { console.error(err); })
</script>

<!-- ── LobbyBridge: 從 gamelobby 進入時自動連線 WebSocket 並加入遊戲 ── -->
<script>
(function() {
    var params = new URLSearchParams(window.location.search);
    var gameId   = params.get('gameId');
    var token    = params.get('token');
    var gameType = parseInt(params.get('gameType')) || 16;
    var seatId   = parseInt(params.get('seatId')) || 1;

    if (!gameId) {
        console.log('[LobbyBridge] No gameId in URL, skip auto-join');
        return;
    }

    window.__LOBBY_PARAMS__ = {
        gameId: gameId,
        token: token,
        gameType: gameType,
        seatId: seatId
    };
    console.log('[LobbyBridge] Game params:', window.__LOBBY_PARAMS__);

    var wsUrl = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/game-ws';

    function waitForPbAndConnect() {
        if (!window.mahjong_pb || !window.mahjong_pb.encodeWSMessage) {
            setTimeout(waitForPbAndConnect, 300);
            return;
        }
        console.log('[LobbyBridge] mahjong_pb ready, connecting to', wsUrl);

        var ws = new WebSocket(wsUrl, 'protobuf');
        ws.binaryType = 'arraybuffer';

        ws.onopen = function() {
            console.log('[LobbyBridge] Connected! Sending join_room for game:', gameId);
            try {
                var joinReqData = window.mahjong_pb.encodeJoinRoomReq({
                    room_id: gameId,
                    player_id: String(seatId)
                });
                var envelope = window.mahjong_pb.encodeWSMessage({
                    action: 'join_room',
                    data: joinReqData
                });
                ws.send(envelope);
                console.log('[LobbyBridge] join_room sent');
            } catch(e) {
                console.error('[LobbyBridge] encode/send error:', e);
            }
        };

        ws.onmessage = function(ev) {
            if (!(ev.data instanceof ArrayBuffer)) return;
            try {
                var msg = window.mahjong_pb.decodeWSMessage(new Uint8Array(ev.data));
                console.log('[LobbyBridge] << action:', msg.action);

                var innerData = {};
                if (msg.action === 'sync_state' && msg.data) {
                    innerData = window.mahjong_pb.decodeSyncStateData(msg.data);
                } else if (msg.action === 'deal_tiles' && msg.data) {
                    innerData = window.mahjong_pb.decodeDealTilesData(msg.data);
                } else if (msg.action === 'join_room_res' && msg.data) {
                    innerData = window.mahjong_pb.decodeJoinRoomRes(msg.data);
                } else if (msg.action === 'player_action_res' && msg.data) {
                    innerData = window.mahjong_pb.decodePlayerActionRes(msg.data);
                } else if (msg.action === 'action_broadcast' && msg.data) {
                    innerData = window.mahjong_pb.decodeActionBroadcastData(msg.data);
                }

                if (window.__COCOS_EVENT_MGR__) {
                    window.__COCOS_EVENT_MGR__.emit('net_message_received', { action: msg.action, data: innerData });
                    window.__COCOS_EVENT_MGR__.emit('ws_' + msg.action, innerData);
                }
            } catch(e) {
                console.error('[LobbyBridge] message decode error:', e);
            }
        };

        ws.onerror = function(e) {
            console.error('[LobbyBridge] WS error:', e);
        };

        ws.onclose = function(e) {
            console.log('[LobbyBridge] WS closed:', e.code, e.reason);
        };

        window.__LOBBY_WS__ = ws;
    }

    setTimeout(waitForPbAndConnect, 1500);
})();
</script>

</body>
</html>
